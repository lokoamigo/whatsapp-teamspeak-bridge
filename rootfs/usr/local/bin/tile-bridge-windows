#!/usr/bin/env python3
"""Tile normal windows on the active desktop, leaving dialogs floating."""

import math
import re
import subprocess
import sys
import time

# _NET_WM_STATE atom -> wmctrl -b property name
STATES = {
    '_NET_WM_STATE_MAXIMIZED_VERT': 'maximized_vert',
    '_NET_WM_STATE_MAXIMIZED_HORZ': 'maximized_horz',
    '_NET_WM_STATE_FULLSCREEN': 'fullscreen',
    '_NET_WM_STATE_SHADED': 'shaded',
}


def output(*args):
    return subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL)


def command(*args):
    # Windows can close between enumeration and layout; arrange the rest anyway.
    subprocess.run(args, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def read_properties(window):
    """Return (first window type atom or None, transient parent, state atoms, frame extents)."""
    text = output('xprop', '-id', window, '_NET_WM_WINDOW_TYPE', 'WM_TRANSIENT_FOR',
                  '_NET_WM_STATE', '_NET_FRAME_EXTENTS')
    types = re.search(r'^_NET_WM_WINDOW_TYPE\(ATOM\) = (.*)$', text, re.M)
    first_type = types.group(1).split(',')[0].strip() if types else None
    transient = re.search(r'^WM_TRANSIENT_FOR\(.*\).*window id # (0x[0-9a-fA-F]+)', text, re.M)
    parent = int(transient.group(1), 16) if transient else 0
    states = re.search(r'^_NET_WM_STATE\(ATOM\) = (.*)$', text, re.M)
    state = {s.strip() for s in states.group(1).split(',')} if states else set()
    extents = re.search(r'^_NET_FRAME_EXTENTS\(CARDINAL\) = (\d+), (\d+), (\d+), (\d+)', text, re.M)
    borders = tuple(map(int, extents.groups())) if extents else (0, 0, 0, 0)
    return first_type, parent, state, borders


def active_window():
    match = re.search(r'window id # (0x[0-9a-fA-F]+)', output('xprop', '-root', '_NET_ACTIVE_WINDOW'))
    return int(match.group(1), 16) if match else 0


def list_windows(desktop_id):
    """Yield window ids on the current desktop (or sticky, reported as -1)."""
    for line in output('wmctrl', '-l').splitlines():
        fields = line.split(None, 3)
        if len(fields) >= 3 and int(fields[1]) in (desktop_id, -1):
            yield fields[0]


def release_states(window, state):
    """Remove maximized/fullscreen/shaded and return the frame extents afterwards."""
    removed = state & STATES.keys()
    for atom in sorted(removed):
        command('wmctrl', '-ir', window, '-b', f'remove,{STATES[atom]}')
    # The window manager changes the frame asynchronously; poll briefly.
    for _ in range(10):
        time.sleep(0.05)
        _, _, state, borders = read_properties(window)
        if not state & removed:
            break
    return borders


def main():
    desktop = next((line for line in output('wmctrl', '-d').splitlines()
                    if len(line.split()) > 1 and line.split()[1] == '*'), None)
    if desktop is None:
        raise RuntimeError('Tile: window manager did not report the current desktop.')
    desktop_id = int(desktop.split()[0])
    workarea = re.search(r'WA:\s*(-?\d+),(-?\d+)\s+(\d+)x(\d+)', desktop)
    if not workarea:
        raise RuntimeError('Tile: window manager did not report a desktop work area.')
    x, y, width, height = map(int, workarea.groups())
    previous = active_window()
    windows = []
    for window in list_windows(desktop_id):
        try:
            first_type, parent, state, borders = read_properties(window)
        except subprocess.CalledProcessError:
            continue
        # Only the first (preferred) type counts: "DIALOG, NORMAL" is a dialog and
        # the tint2 panel is a DOCK. No type and no transient parent means normal.
        if (first_type and first_type != '_NET_WM_WINDOW_TYPE_NORMAL') or parent:
            continue
        windows.append((window, state, borders))
    if not windows:
        return
    columns = math.ceil(math.sqrt(len(windows)))
    rows = math.ceil(len(windows) / columns)
    for index, (window, state, borders) in enumerate(windows):
        column, row = index % columns, index // columns
        cell_x, cell_y = x + column * width // columns, y + row * height // rows
        cell_width = (column + 1) * width // columns - column * width // columns
        cell_height = (row + 1) * height // rows - row * height // rows
        try:
            if state & STATES.keys():
                borders = release_states(window, state)
        except subprocess.CalledProcessError:
            continue  # window vanished while waiting
        if '_NET_WM_STATE_HIDDEN' in state:
            command('wmctrl', '-ia', window)
        left, right, top, bottom = borders
        command('wmctrl', '-ir', window, '-e', f'0,{cell_x},{cell_y},{max(1, cell_width - left - right)},{max(1, cell_height - top - bottom)}')
    if previous and any(int(window, 16) == previous for window in list_windows(desktop_id)):
        command('wmctrl', '-ia', f'0x{previous:08x}')


def fail(message):
    print(message, file=sys.stderr)
    try:
        subprocess.Popen(['xmessage', '-center', '-timeout', '8', message],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass
    sys.exit(1)


if __name__ == '__main__':
    try:
        main()
    except RuntimeError as error:
        fail(str(error))
    except subprocess.CalledProcessError as error:
        fail(f'Tile: {error.cmd[0]} failed.')
    except OSError as error:
        fail(f'Tile: could not run helper tool ({error.filename or error.strerror}).')
