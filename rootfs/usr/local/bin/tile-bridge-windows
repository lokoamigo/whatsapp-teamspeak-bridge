#!/usr/bin/env python3
"""Tile normal windows on the active desktop, leaving dialogs floating."""

import math
import re
import subprocess


def output(*args):
    return subprocess.check_output(args, text=True)


def command(*args):
    # Windows can close between enumeration and layout; arrange the rest anyway.
    subprocess.run(args, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    desktop = next(line for line in output('wmctrl', '-d').splitlines() if line.split()[1] == '*')
    desktop_id = int(desktop.split()[0])
    workarea = re.search(r'WA:\s*(-?\d+),(-?\d+)\s+(\d+)x(\d+)', desktop)
    if not workarea:
        raise RuntimeError('The window manager did not report a desktop work area.')
    x, y, width, height = map(int, workarea.groups())
    windows = []
    for line in output('wmctrl', '-l').splitlines():
        fields = line.split(None, 3)
        if len(fields) < 3 or int(fields[1]) != desktop_id:
            continue
        window = fields[0]
        try:
            properties = output('xprop', '-id', window, '_NET_WM_WINDOW_TYPE', 'WM_TRANSIENT_FOR', '_NET_FRAME_EXTENTS')
        except subprocess.CalledProcessError:
            continue
        if '_NET_WM_WINDOW_TYPE(ATOM)' in properties and '_NET_WM_WINDOW_TYPE_NORMAL' not in properties:
            continue
        transient = re.search(r'WM_TRANSIENT_FOR\(.*\).*window id # (0x[0-9a-fA-F]+)', properties)
        if transient and int(transient.group(1), 16):
            continue
        extents = re.search(r'_NET_FRAME_EXTENTS\(CARDINAL\) = (\d+), (\d+), (\d+), (\d+)', properties)
        borders = tuple(map(int, extents.groups())) if extents else (0, 0, 0, 0)
        windows.append((window, borders))
    if not windows:
        return
    columns = math.ceil(math.sqrt(len(windows)))
    rows = math.ceil(len(windows) / columns)
    for index, (window, (left, right, top, bottom)) in enumerate(windows):
        column, row = index % columns, index // columns
        cell_x, cell_y = x + column * width // columns, y + row * height // rows
        cell_width = (column + 1) * width // columns - column * width // columns
        cell_height = (row + 1) * height // rows - row * height // rows
        command('wmctrl', '-ir', window, '-b', 'remove,maximized_vert,maximized_horz')
        command('wmctrl', '-ir', window, '-b', 'remove,fullscreen,shaded')
        command('wmctrl', '-ir', window, '-e', f'0,{cell_x},{cell_y},{max(1, cell_width - left - right)},{max(1, cell_height - top - bottom)}')
        command('wmctrl', '-ia', window)


if __name__ == '__main__':
    main()
