#!/usr/bin/env bash
set -euo pipefail
if [[ "${BRIDGE_VOICE_BACKEND:-teamspeak}" != teamspeak-mumble &&
      ( "${BRIDGE_VOICE_BACKEND:-teamspeak}" != mumble || "${BRIDGE_MUMBLE_CLIENT:-gui}" != native ) ]]; then
  echo >&2 'The native Mumble client requires the combined backend or the native Mumble backend.'
  exit 1
fi
/usr/local/bin/wait-for-audio
exec /usr/local/bin/bridge-mumble
