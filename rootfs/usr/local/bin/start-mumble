#!/usr/bin/env bash
set -euo pipefail
/usr/local/bin/wait-for-display
/usr/local/bin/wait-for-audio

export HOME=/data/mumble
export XDG_CONFIG_HOME=/data/mumble/.config
export XDG_DATA_HOME=/data/mumble/.local/share
# Reuse the crossed voice/WhatsApp devices so Chromium keeps its saved microphone.
export PULSE_SINK=ts_out
export PULSE_SOURCE=wa_mic
export QT_X11_NO_MITSHM=1
export LIBGL_ALWAYS_SOFTWARE=1

mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME"

args=()
if [[ -n "${MUMBLE_URI:-}" ]]; then
  if [[ "$MUMBLE_URI" != mumble://* ]]; then
    echo >&2 "MUMBLE_URI must start with mumble://."
    exit 1
  fi
  args+=("$MUMBLE_URI")
fi
# Mumble 1.3 writes Mumble.conf (audio setup, certificate, wizard state) only
# after a clean exit. A plain SIGTERM from supervisord/docker would discard it,
# so on stop: close open dialogs, then trigger Mumble's own "Quit" (Ctrl+Q,
# which also skips the "close or minimize?" prompt while connected).
stopping=
mumble_pid=
quit_mumble() {
  stopping=1
  [[ -n "$mumble_pid" ]] || return 0
  local deadline=$((SECONDS + ${MUMBLE_QUIT_TIMEOUT:-8})) windows main dialog
  while kill -0 "$mumble_pid" 2>/dev/null && (( SECONDS < deadline )); do
    # X calls are time-limited: without a window manager --sync would wait forever.
    windows="$(timeout 2 wmctrl -lp 2>/dev/null | awk -v pid="$mumble_pid" '$3 == pid')" || windows=
    # wmctrl -lp: id, desktop, pid, host, title. (mawk has no {n} regex intervals.)
    main="$(awk '{ title = $0; for (i = 0; i < 4; i++) sub(/^[^ ]+ +/, "", title) }
                 title ~ /^Mumble( - Minimal View)? -- / { print $1; exit }' <<<"$windows")"
    dialog="$(awk -v main="$main" '$1 != main { id = $1 } END { print id }' <<<"$windows")"
    if [[ -n "$dialog" ]]; then
      timeout 2 wmctrl -ic "$dialog" 2>/dev/null || true
      sleep 0.5
    elif [[ -n "$main" ]]; then
      timeout 2 xdotool windowactivate --sync "$main" key --clearmodifiers ctrl+q 2>/dev/null || true
      sleep 1
    else
      sleep 0.2
    fi
  done
  if kill -0 "$mumble_pid" 2>/dev/null; then
    echo >&2 "Mumble did not quit cleanly; sending SIGTERM. Unsaved Mumble settings are lost."
    kill -TERM "$mumble_pid" 2>/dev/null || true
  fi
}

# Trap before starting Mumble so an early stop request cannot orphan it.
trap quit_mumble TERM INT
/usr/bin/mumble "${args[@]}" &
mumble_pid=$!
[[ -z "$stopping" ]] || quit_mumble
status=0
wait "$mumble_pid" || status=$?
if [[ -n "$stopping" ]]; then
  status=0
  wait "$mumble_pid" || status=$?
fi
exit "$status"
