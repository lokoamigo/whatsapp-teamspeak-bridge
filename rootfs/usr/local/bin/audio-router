#!/usr/bin/env bash
set -euo pipefail

socket="${XDG_RUNTIME_DIR:-/tmp/runtime-bridge}/pulse/native"
seen_chromium_sources="/tmp/audio-router-chromium-sources.seen"
whatsapp_source="${BRIDGE_WHATSAPP_PULSE_SOURCE:-ts_mic}"
whatsapp_source_nudge="${BRIDGE_WHATSAPP_PULSE_SOURCE_NUDGE:-wa_mic}"

ensure_audio_graph() {
  [[ -S "$socket" ]] || return 1
  pactl info >/dev/null 2>&1 || return 1

  if ! pactl list short sinks | awk '{print $2}' | grep -qx 'ts_out'; then
    pactl load-module module-null-sink \
      sink_name=ts_out \
      rate=48000 channels=2 channel_map=front-left,front-right \
      sink_properties=device.description=TeamSpeak_to_WhatsApp >/dev/null
  fi

  if ! pactl list short sinks | awk '{print $2}' | grep -qx 'wa_out'; then
    pactl load-module module-null-sink \
      sink_name=wa_out \
      rate=48000 channels=2 channel_map=front-left,front-right \
      sink_properties=device.description=WhatsApp_to_TeamSpeak >/dev/null
  fi

  if ! pactl list short sources | awk '{print $2}' | grep -qx 'ts_mic'; then
    pactl load-module module-remap-source \
      source_name=ts_mic \
      master=ts_out.monitor \
      rate=48000 channels=2 channel_map=front-left,front-right \
      master_channel_map=front-left,front-right \
      source_properties=device.description=TeamSpeak_to_WhatsApp_Microphone >/dev/null
  fi

  if ! pactl list short sources | awk '{print $2}' | grep -qx 'wa_mic'; then
    pactl load-module module-remap-source \
      source_name=wa_mic \
      master=wa_out.monitor \
      rate=48000 channels=2 channel_map=front-left,front-right \
      master_channel_map=front-left,front-right \
      source_properties=device.description=WhatsApp_to_TeamSpeak_Microphone >/dev/null
  fi

  # WhatsApp tends to re-open the PulseAudio default devices for each call.
  # Its playback must feed TeamSpeak, and its microphone must receive TeamSpeak.
  pactl set-default-sink wa_out || true
  pactl set-default-source ts_mic || true
  touch /tmp/audio-ready
}

route_streams() {
  pactl list sink-inputs | awk '
    /^Sink Input #/ { id = substr($3, 2) }
    /application.process.binary = "chromium"/ { print id " wa_out" }
    /application.process.binary = "ts3client_linux_amd64"/ { print id " ts_out" }
  ' | while read -r input target; do
    [[ -n "${input:-}" && -n "${target:-}" ]] || continue
    pactl move-sink-input "$input" "$target" >/dev/null 2>&1 || true
  done

  pactl list source-outputs | awk -v whatsapp_source="$whatsapp_source" '
    /^Source Output #/ { id = substr($3, 2) }
    /application.process.binary = "chromium"/ { print id " " whatsapp_source }
    /application.process.binary = "ts3client_linux_amd64"/ { print id " wa_mic" }
  ' | while read -r output target; do
    [[ -n "${output:-}" && -n "${target:-}" ]] || continue
    if [[ "$target" = "$whatsapp_source" ]] && ! grep -qx "$output" "$seen_chromium_sources" 2>/dev/null; then
      printf '%s\n' "$output" >>"$seen_chromium_sources"
      # WhatsApp Web sometimes keeps a stale in-call "Default" microphone until
      # Chromium receives a device/default-source change after WebRTC opens.
      pactl set-default-source "$whatsapp_source_nudge" >/dev/null 2>&1 || true
      sleep 0.2
      pactl set-default-source "$whatsapp_source" >/dev/null 2>&1 || true
    fi
    pactl move-source-output "$output" "$target" >/dev/null 2>&1 || true
  done
}

rm -f /tmp/audio-ready
rm -f "$seen_chromium_sources"
while true; do
  if ensure_audio_graph; then
    route_streams || true
  fi
  sleep 3
done
