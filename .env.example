# TeamSpeak-Installer darf nur gebaut werden, wenn du die Lizenz gelesen und akzeptiert hast.
TS3_LICENSE_ACCEPTED=NO
TS3_VERSION=3.6.2

TZ=Europe/Berlin
VNC_PASSWORD=change-me-now
DISPLAY_WIDTH=1440
DISPLAY_HEIGHT=900
DISPLAY_DEPTH=24

# Optional: automatischer TeamSpeak-Connect. Sonderzeichen URL-kodieren.
# TS3_URI=ts3server://ts.example.org?port=9987&nickname=WhatsAppBridge
TS3_URI=

# Optional: ClientQuery-API-Key aus dem TeamSpeak-ClientQuery-Plugin.
TS3_CLIENTQUERY_API_KEY=

# TeamSpeak-Textbefehle fuer den WhatsApp-Call-Bot.
# Leer bedeutet: jeder TeamSpeak-Nutzer, der den Bridge-Client anschreiben kann,
# darf Befehle ausfuehren. Besser: eine kommagetrennte Liste erlaubter TS-UIDs.
BRIDGE_COMMAND_PREFIX=!wa
BRIDGE_COMMANDER_UIDS=

NOVNC_PORT=6080
CHROMEDRIVER_PORT=9515
CLIENTQUERY_PORT=25640
