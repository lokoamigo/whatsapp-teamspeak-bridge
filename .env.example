# TeamSpeak-Installer darf nur gebaut werden, wenn du die Lizenz gelesen und akzeptiert hast.
TS3_LICENSE_ACCEPTED=NO
TS3_VERSION=3.6.2

# Voice backend: teamspeak (default), mumble or teamspeak-mumble. Rebuild when switching.
# teamspeak-mumble requires the TeamSpeak license acknowledgement and MUMBLE_URI,
# selects native Mumble automatically and keeps the TeamSpeak desktop running.
# Mumble builds do not download TeamSpeak or require its license acceptance.
BRIDGE_VOICE_BACKEND=teamspeak
BRIDGE_MUMBLE_CLIENT=gui
# Native mode uses one audio/chat account and requires MUMBLE_URI.
MUMBLE_NATIVE_BITRATE=32000
# Optional PEM/PKCS#12 import path inside /data; GUI identity is imported automatically.
MUMBLE_NATIVE_IDENTITY_IMPORT=
MUMBLE_NATIVE_IDENTITY_PASSWORD=
# Optional Mumble auto-connect; URL-encode username, password and channel names.
# MUMBLE_URI=mumble://WhatsAppBridge@mumble.example.org:64738/Bridge
# Also enables `!wa` chat commands. GUI mode adds a "<user>-Bot" account;
# native mode uses the audio account. BRIDGE_COMMANDER_UIDS holds certificate hashes.
MUMBLE_URI=
# Optional separate bot identity/server, e.g. mumble://WhatsAppBot@mumble.example.org/Bridge
MUMBLE_BOT_URI=

TZ=Europe/Berlin
VNC_PASSWORD=change-me-now
DISPLAY_WIDTH=1440
DISPLAY_HEIGHT=900
DISPLAY_DEPTH=24

# Optional: automatischer TeamSpeak-Connect. Sonderzeichen URL-kodieren.
# TS3_URI=ts3server://ts.example.org?port=9987&nickname=WhatsAppBridge
TS3_URI=

# Optional: ClientQuery-API-Key aus dem TeamSpeak-ClientQuery-Plugin.
TS3_CLIENTQUERY_API_KEY=

# TeamSpeak-Textbefehle fuer den WhatsApp-Call-Bot.
# Leer bedeutet: jeder TeamSpeak-Nutzer, der den Bridge-Client anschreiben kann,
# darf Befehle ausfuehren. Im kombinierten Modus TS-UIDs und Mumble-Zertifikathashes
# gemeinsam als kommagetrennte Liste eintragen.
BRIDGE_COMMAND_PREFIX=!wa
BRIDGE_COMMANDER_UIDS=
# JSON-Map aus Gruppennamen auf Telefonnummern fuer `!wa call <gruppe>`.
BRIDGE_CONTACT_GROUPS={"support":["+491701234567","+491761234567"]}
# WhatsApp-Textbefehl: Sender in den laufenden WhatsApp-Call einladen.
BRIDGE_WHATSAPP_INVITE_COMMAND=!invite
# Poll-Fallback fuer eingehende WhatsApp-Anrufe in Millisekunden.
BRIDGE_AUTO_ACCEPT_POLL_MS=5000
# Experimentelles lokales WhatsApp-Web-Calling-Gate nach jedem Login aktivieren.
BRIDGE_FORCE_WEB_CALLING=true
# Lokaler HTTP-API-Port fuer den aktuellen WhatsApp-Call-Status.
BRIDGE_API_PORT=8080
# Allgemeine Hinweise im Voice-Kanal-Chat, wenn jemand dem WhatsApp-Anruf
# beitritt oder ihn verlaesst (ohne Nummern oder Namen).
BRIDGE_CALL_ANNOUNCEMENTS=true
BRIDGE_CALL_ANNOUNCE_POLL_MS=3000

NOVNC_PORT=6080
CLIENTQUERY_PORT=25640
