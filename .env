# Muss zum Build bewusst auf YES gesetzt werden.
TS3_LICENSE_ACCEPTED=YES
TS3_VERSION=3.6.2

TZ=Europe/Berlin
VNC_PASSWORD=BITTE-EIN-STARKES-PASSWORT-SETZEN
DISPLAY_WIDTH=1440
DISPLAY_HEIGHT=900
DISPLAY_DEPTH=24

# Optionaler Auto-Connect. Sonderzeichen URL-kodieren.
# Beispiel:
# TS3_URI=ts3server://ts.example.org?port=9987&nickname=WhatsAppBridge
TS3_URI=ts3server://0x29a.me?port=4711&nickname=WhatsAppBridge

# Nach Aktivierung des ClientQuery-Plugins im TS3-GUI dort erzeugten API-Key eintragen.
TS3_CLIENTQUERY_API_KEY=

NOVNC_PORT=6080
CHROMEDRIVER_PORT=9515
CLIENTQUERY_PORT=25640
